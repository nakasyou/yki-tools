{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowArbitraryExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "ripple",
    "plugins": [{ "name": "@tsrx/typescript-plugin" }]
  },
  "include": ["src/**/*", "vite.config.ts"]
}
