               cube([22,3,liteBaseHeight]);\n            }\n            // Keep both original circular ends, overlapping the adjacent\n            // support so the rounded borders stay connected to the frame.\n            translate([-11,19.1,0]) {\n                cube([22,11,trackHeight]);\n            }\n            translate([-11,-30,0]) {\n                cube([22,11.1,liteBaseHeight]);\n            }\n        }\n    }\n}\n\n// The inner strips beside the reading track are functional guides.\n// The outer arcs and crossbars form the decorative frames around the text.\nmodule side_guides(include_rim = true) {\n        guide_opening = 19 + 2 * guideInset;\n        difference() {\n\n            cylinder(d=43, h=totalHeight, $fn=100);\n            translate([-guide_opening/2,-43/2,-1]) {\n                cube([guide_opening, 43 , totalHeight+6]);\n            }\n            translate([0,0,-1]) {\n                difference() {\n                    cylinder(d=39, h=totalHeight+2, $fn=100);\n                    translate([-22/2,-43/2,-2]) {\n                        cube([22, 43 , totalHeight+3]);\n                    }\n                }\n            }\n            translate([-9,-19,0]) {\n                rotate([0,0,45]) {\n                    cube([3,3,totalHeight*3], center=true);\n                }\n            }\n            translate([9,-19,0]) {\n                rotate([0,0,45]) {\n                    cube([3,3,totalHeight*3], center=true);\n                }\n            }        \n            translate([-9,19,0]) {\n                rotate([0,0,45]) {\n                    cube([3,3,totalHeight*3], center=true);\n                }\n            }\n            translate([9,19,0]) {\n                rotate([0,0,45]) {\n                    cube([3,3,totalHeight*3], center=true);\n                }\n            }        \n            if (!include_rim) {\n                translate([11,-30,-1]) cube([30,60,totalHeight+2]);\n                translate([-41,-30,-1]) cube([30,60,totalHeight+2]);\n            }\n        }\n}\n\nmodule side() {\n    union() {\n        side_guides();\n        translate([-10+(-19)/2,4,0]) {\n            cube([10-guideInset,1.5,totalHeight]);\n        }\n        translate([-10+(-19)/2,-4-1,0]) {\n            cube([10-guideInset,1.5,totalHeight]);\n        }\n        translate([19/2+guideInset,4,0]) {\n            cube([10-guideInset,1.5,totalHeight]);\n        }\n        translate([19/2+guideInset,-4-1,0]) {\n            cube([10-guideInset,1.5,totalHeight]);\n        }\n        if (mode == \"classic\") {\n          translate([-18.5,-3,trackHeight-0.01]) {\n            text_you(0.5+0.01);\n        }        \n        translate([11,-3,trackHeight-0.01]) {\n            text_money(0.5+0.01);\n        }\n        }\n\n    }\n}\n\nmodule codebar1() {\n    translate([0,-1,0]) {\n        union() {\n            cube([3.8,2,totalHeight-1]);\n            translate([0,1,totalHeight-1]) {\n                rotate([0,90,0]) {\n                    cylinder(r=1, h=3.8, $fn=50);\n                }\n            }\n        }\n    }\n}\n\nmodule codebar(code) {\n    union() {\n        for(i=[0:3]) {\n            if (code[i]==\"1\") {\n                translate([-15.7/2+3.8*i+i*(15.7-3.8*4)/3.0,0,0]) {\n                    codebar1();\n                }\n                if (i<3 && code[i+1]==\"1\") {\n                    translate([-15.7/2+3.8*i+3.8/2+i*(15.7-3.8*4)/3.0,0,0]) {\n                        codebar1();\n                    }\n                }\n            }\n        }\n    }\n}\n\nmodule codebars(code1, code2, code3, code4) {\n    codebar(code4);\n    translate([0,6,0]) {\n        codebar(code3);\n    }\n    translate([0,6*2,0]) {\n        codebar(code2);\n    }\n    translate([0,6*3,0]) {\n        codebar(code1);\n    }\n}\n\nif (lite) {\n    translate([0,0,-baseReduction])\n    intersection() {\n        union() {\n            lite_track();\n            side_guides(include_rim = false);\n            codebars(str(code1),str(code2),str(code3),str(code4));\n        }\n        // Trim the base flush with the outside edges of both guides.\n        translate([-11,-30,baseReduction]) {\n            cube([22,60,totalHeight+2]);\n        }\n    }\n} else {\n    translate([0,0,-baseReduction])\n    intersection() {\n        classical_medal();\n        translate([-30,-30,baseReduction]) cube([60,60,totalHeight+2]);\n    }\n}\n\nmodule classical_medal() {\n  difference() {\n    union() {\n        track(thin_blank = true);\n        side();\n        codebars(str(code1),str(code2),str(code3),str(code4));\n    }\n    translate([0,0,-1.0]) {\n        difference() {\n            cylinder(d=38, h=0.5+1.0, $fn=100);\n            if (mode == \"classic\") {\n              translate([-5,21.5/2,-2]) {\n                cube([10,43/2,2+2]);\n            }\n            translate([-5,(-43/2)-21.5/2,-2]) {\n                cube([10,43/2,2+2]);\n            }\n            }\n        }\n    }\n    if (mode == \"classic\") {\n      translate([-6.8/2,43/2-2.5-6.8,-1.0]) {\n        cube([6.8,6.8,0.5+1.0]);\n    }\n    translate([-6.8/2,-43/2+2.5,-1.0]) {\n        cube([6.8,6.8,0.5+1.0]);\n    }    \n    }\n  }\n}\n\n\n",
