let schema_json : String = "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://yki.local/schema/v1.json\",\"title\":\"Yo-kai Watch U YKI build configuration\",\"description\":\"Paths are relative to this JSON file. IDs select existing 1..988 table rows; unknown physical-code conversion is never invented.\",\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"$schema\":{\"type\":\"string\"},\"extends\":{\"oneOf\":[{\"type\":\"integer\",\"enum\":[2,3,4,5,6,7]},{\"type\":\"string\",\"minLength\":1,\"pattern\":\"\\\\.[yY][kK][iI]$\"}]},\"version\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":10,\"description\":\"Selects built-in spoken-version ID 0x40 + version. Not a proven firmware identity.\"},\"output\":{\"type\":\"string\",\"minLength\":1},\"mappingPolicy\":{\"enum\":[\"warn\",\"strict\"],\"default\":\"warn\"},\"audio\":{\"$ref\":\"#/$defs/audioOptions\"},\"overrides\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/override\"}}},\"required\":[\"extends\",\"overrides\"],\"$defs\":{\"id\":{\"oneOf\":[{\"type\":\"integer\",\"minimum\":1,\"maximum\":988},{\"type\":\"string\",\"pattern\":\"^[Bb][0-9]{1,3}$\"},{\"type\":\"string\",\"pattern\":\"^(0[xX])?[0-9a-fA-F]{4}$\",\"not\":{\"type\":\"string\",\"pattern\":\"^[Bb][0-9]{1,3}$\"}},{\"type\":\"array\",\"minItems\":4,\"maxItems\":4,\"items\":{\"type\":\"string\",\"pattern\":\"^[01]{4}$\"}},{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"medal\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":988}},\"required\":[\"medal\"]},{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"bumpsHex\":{\"type\":\"string\",\"pattern\":\"^(0[xX])?[0-9a-fA-F]{4}$\"}},\"required\":[\"bumpsHex\"]},{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"bumps\":{\"type\":\"array\",\"minItems\":4,\"maxItems\":4,\"items\":{\"type\":\"string\",\"pattern\":\"^[01]{4}$\"}}},\"required\":[\"bumps\"]},{\"type\":\"object\",\"additionalProperties\"